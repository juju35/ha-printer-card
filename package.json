{
  "name": "ha-printer-card",
  "version": "2.11.0",
  "description": "Lovelace card for printers in Home Assistant: HP Printer integration, and any brand through the IPP integration.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node --check dist/printer-card.js",
    "screenshots": "node scripts/screenshots.mjs",
    "models": "node scripts/models.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:browser": "node --test test/layout.browser.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.19.0",
    "css-tree": "^3.2.1",
    "playwright": "^1.64.1"
  }
}
